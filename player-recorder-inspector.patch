+ body.player #props.cris-player-inspector.cris-player-recorder-open.show{display:flex!important;bottom:calc(78px + env(safe-area-inset-bottom))!important;top:auto!important;left:8px!important;right:8px!important;width:auto!important;max-height:calc(65dvh - 80px)}
