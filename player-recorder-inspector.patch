 @media(max-width:760px),(max-height:520px){
  body.player:not(.qi-ed) #props.cris-player-inspector{display:none!important}
- body.player.qi-ed #props.cris-player-inspector.show{display:flex!important;bottom:calc(78px + env(safe-area-inset-bottom))!important;top:auto!important;left:8px!important;right:8px!important;width:auto!important;max-height:calc(65dvh - 80px)}
